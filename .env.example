# Copy to .env; fill both secret values before docker compose up --build -d.
# Generate independent random values, e.g. openssl rand -hex 32.
FREEDOMSHOP_SECRET_KEY=
POSTGRES_PASSWORD=
FREEDOMSHOP_ALLOWED_HOSTS=localhost,127.0.0.1
# Keep loopback for a proxy on this host; otherwise use the required LAN/VPN interface.
# 0.0.0.0 listens on all IPv4 interfaces; restrict access with a firewall.
# Public-internet exposure is not recommended; see INSTALL.md#network-access.
FREEDOMSHOP_BIND_ADDRESS=127.0.0.1
FREEDOMSHOP_PORT=8001
FREEDOMSHOP_HTTP_PORT=8080
# Enable HTTPS only behind a TLS proxy that overwrites X-Forwarded-Proto.
FREEDOMSHOP_HTTPS=0
