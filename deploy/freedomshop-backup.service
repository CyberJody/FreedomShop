[Unit]
Description=FreedomShop nightly backup, when due by the Backups page schedule
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# The time, on/off and retention count are set on the Backups page; this only checks if a run is due.
ExecStart=/usr/local/bin/freedomshop manage run_scheduled_backup
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
UMask=0077
